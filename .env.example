# ==============================================================================
# Immich Static Video Toolkit Configuration
# ==============================================================================

# Immich Server Connection
# ------------------------------------------------------------------------------
# The base URL of your Immich instance (without trailing slash)
IMMICH_API_URL=http://localhost:2283

# Your Immich API Key (generated in Immich: Account Settings -> API Keys)
IMMICH_API_KEY=your_immich_api_key_here

# Paths & Directories
# ------------------------------------------------------------------------------
# Path to your mounted Immich library directory (read-only recommended)
IMMICH_LIBRARY_PATH=/path/to/immich/library

# Path to the SQLite checkpoint database
DB_PATH=./detection_checkpoint.sqlite

# Directory to save extracted still frames
EXTRACT_OUTPUT_DIR=./extracted_frames

# Immich Tag Names (Namespaced Prefix Style)
# ------------------------------------------------------------------------------
TAG_STATIC=video:static
TAG_REVIEW=video:review
TAG_DYNAMIC=video:dynamic
TAG_EXTRACTED=video:extracted

# Detection & Extraction Settings
# ------------------------------------------------------------------------------
# Sensitivity level: low | medium | high (default: medium)
SENSITIVITY=medium

# Worker threads for multi-threaded processing (leave empty for auto-detection)
WORKERS=

# Frame Extraction format: jpg | png (default: jpg)
EXTRACT_FORMAT=jpg

# JPG Quality: 1-100 (default: 95)
EXTRACT_QUALITY=95

# Watcher Daemon Settings (Polling mode)
# ------------------------------------------------------------------------------
# Seconds between incremental scan cycles in watch.py (default: 300)
WATCH_INTERVAL=300

# Webhook Server Settings (Event-driven mode)
# ------------------------------------------------------------------------------
# Host interface to bind webhook HTTP server (default: 0.0.0.0)
WEBHOOK_HOST=0.0.0.0

# Port to listen for Immich workflow webhooks (default: 8080)
WEBHOOK_PORT=8080

# Shared secret token for webhook authorization (header: X-Webhook-Secret)
WEBHOOK_SECRET=

# Docker Container <-> Host Path Remapping (Optional)
# If Immich originalPath is inside a container, map it to your local filesystem:
# IMMICH_REMOTE_PATH_PREFIX=/usr/src/app/upload
# IMMICH_LOCAL_PATH_PREFIX=/mnt/storage/immich

